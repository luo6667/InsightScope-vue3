# 舆情雷达 InsightScope · 服务端环境变量示例
# 复制为 .env 后按需修改（或直接以环境变量方式注入）

# 端口（默认 5176）
# PORT=5176

# MySQL 连接（默认 root:1234@127.0.0.1:3306，库名 plfx；生产必改）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=1234
# MYSQL_DATABASE=plfx

# CORS 白名单（逗号分隔，允许的前端域名；默认本地 dev 前后端）
# CORS_ORIGIN=http://localhost:5175,http://localhost:5176

# 写接口限流（次/分钟/IP；0=关闭，公网部署建议 60）
# RATE_LIMIT_PER_MIN=60

# 访问口令（Bearer token，生产必填）：设置后所有 /api/* 与 socket.io 连接必须携带
# Authorization: Bearer <ACCESS_TOKEN>，未设置 = 开发模式不启用认证
# ACCESS_TOKEN=change-me-strong-token

# 定时抓取是否允许私网/内网/本机地址（默认允许=1，本地评论服务开箱即用；
# 公网部署且不想让服务器抓内网时设为 0，恢复 SSRF 严格校验）
# ALLOW_PRIVATE_FEED_URL=1

# 运行环境（production 时错误响应不泄露内部细节）
# NODE_ENV=production
