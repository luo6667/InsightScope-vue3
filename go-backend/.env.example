# Set these as process environment variables before starting API, Worker and Scheduler.
PORT=5176
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=1234
MYSQL_DATABASE=plfx
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
# Required: base64 encoding of 32 random bytes. Use the same value for API and Worker.
ANALYSIS_ENCRYPTION_KEY=
# Optional for local development; set a strong value in production.
ACCESS_TOKEN=
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MIN=0
ALLOW_PRIVATE_FEED_URL=1
