# ============ InsightScope Web(Next.js)环境变量模板 ============
# 复制为 .env.local 使用(开发)/ .env.production(生产),按需修改。

# ── 后端地址(仅构建时/dev 时生效,rewrites 代理用) ──
# 开发默认 http://localhost:5176(见 next.config.ts)
API_TARGET=http://localhost:5176

# ── 前端请求 API 的公共前缀(运行时生效) ──
# 默认 /api(走 Next rewrites 代理);若前端与后端不同域部署,改为完整地址,
# 例如 https://api.example.com/api(注意 rewrites 代理会失效)
NEXT_PUBLIC_API_BASE=/api

# ── socket.io 直连地址(运行时生效) ──
# Next rewrites 不支持 WebSocket,socket 必须直连后端。
# 开发默认 http://localhost:5176;生产同域反代时设为空串即可同源:
# NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_SOCKET_URL=http://localhost:5176

# ── proxy 访问控制(生产可选,Next 16 中 middleware 的新约定) ──
# 与后端 server 的 ACCESS_TOKEN 保持同值:设置后 proxy 会拦截 /api/* 校验
# Bearer token;留空 = 开发模式,不启用(与后端 authRequired=false 逻辑一致)。
# 注意:该变量在 next build 时内联,部署时需在构建阶段注入。
# NEXT_ACCESS_TOKEN=
